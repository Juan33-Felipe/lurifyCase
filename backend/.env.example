# Copia este archivo como .env (cp .env.example .env) y ajusta los valores.
# backend/.env no se sube a git.

# --- Base de datos ---
# Local con Docker (por defecto; lo levanta npm run dev):
DB_URL=jdbc:postgresql://localhost:5432/iurify_case_db
DB_USERNAME=iurify_user
DB_PASSWORD=iurify_secure_password_2026

# Neon: usa la cadena de conexión de tu proyecto con formato JDBC, por ejemplo:
# DB_URL=jdbc:postgresql://ep-xxxx-pooler.us-east-1.aws.neon.tech/neondb?sslmode=require&channelBinding=require
# DB_USERNAME=neondb_owner
# DB_PASSWORD=...

# --- Servidor ---
SERVER_PORT=8080

# --- Seguridad ---
# Clave para firmar los JWT (mínimo 64 caracteres para HS512). Genera una propia.
# JWT_SECRET=
JWT_EXPIRATION_SECONDS=3600

# --- IA (Gemini) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
